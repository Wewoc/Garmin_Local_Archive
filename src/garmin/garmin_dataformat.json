{
  "schema_version": "1.1",
  "fields": {
    "date":               { "type": "str",  "required": true  },
    "sleep":              { "type": "dict", "required": false },
    "stress":             { "type": "dict", "required": false,
                            "sub_fields": {
                              "averageStressLevel": { "type": "int", "min": 0,  "max": 100 }
                            }},
    "body_battery":       { "type": "any",  "required": false },
    "heart_rates":        { "type": "dict", "required": false,
                            "sub_fields": {
                              "restingHeartRate": { "type": "int", "min": 20, "max": 300 },
                              "maxHeartRate":     { "type": "int", "min": 20, "max": 300 }
                            }},
    "respiration":        { "type": "dict", "required": false,
                            "sub_fields": {
                              "avgWakingRespirationValue": { "type": "float", "min": 4, "max": 60 }
                            }},
    "spo2":               { "type": "dict", "required": false,
                            "sub_fields": {
                              "averageSpO2": { "type": "float", "min": 50, "max": 100 }
                            }},
    "stats":              { "type": "dict", "required": false },
    "steps":              { "type": "list", "required": false },
    "user_summary":       { "type": "dict", "required": false },
    "training_status":    { "type": "dict", "required": false },
    "training_readiness": { "type": "any",  "required": false },
    "hrv":                { "type": "dict", "required": false },
    "race_predictions":   { "type": "dict", "required": false },
    "max_metrics":        { "type": "any",  "required": false },
    "activities":         { "type": "any",  "required": false },

    "get_body_composition":         { "type": "any", "required": false },
    "get_daily_weigh_ins":          { "type": "any", "required": false },
    "get_blood_pressure":           { "type": "any", "required": false },
    "get_hydration_data":           { "type": "any", "required": false },
    "get_menstrual_calendar_data":  { "type": "any", "required": false },
    "get_pregnancy_summary":        { "type": "any", "required": false },
    "get_lifestyle_logging_data":   { "type": "any", "required": false },
    "get_nutrition_daily_food_log": { "type": "any", "required": false },
    "get_nutrition_daily_meals":    { "type": "any", "required": false },
    "get_nutrition_daily_settings": { "type": "any", "required": false },
    "get_calories_daily":           { "type": "any", "required": false },
    "get_floors":                   { "type": "any", "required": false },
    "get_intensity_minutes_data":   { "type": "any", "required": false },
    "get_body_battery_events":      { "type": "any", "required": false },
    "get_endurance_score":          { "type": "any", "required": false },
    "get_fitnessage_data":          { "type": "any", "required": false },
    "get_hill_score":               { "type": "any", "required": false },
    "get_lactate_threshold":        { "type": "any", "required": false },
    "get_running_tolerance":        { "type": "any", "required": false }
  }
}
