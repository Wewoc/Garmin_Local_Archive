        </mxCell>
        <mxCell id="plSync" value="Garmin sync (per day)&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;fetch 15 endpoints + enabled extras&lt;br&gt;source/ guard, then validator&lt;br&gt;Decision flow, page 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1D9E75;fontColor=#0F6E56;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1">
