        <mxCell id="pmD8" value="out_of_range above 3?&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Validator warnings. yes: label high is capped at standard.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#BA7517;fontColor=#854F0B;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
