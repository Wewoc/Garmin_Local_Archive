        <mxCell id="pmEdge7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#555555;fontSize=11;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pmA4" target="pmAx4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pmEdge8" value="below 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;fontColor=#b85450;fontSize=11;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pmA5" target="pmAx5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pmBandB" value="Prepare, no API call  (steps 1 to 3d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#36393d;fontColor=#333333;fontSize=14;fontStyle=1;verticalAlign=bottom;align=left;spacingLeft=20;spacingBottom=8;opacity=40;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="394" width="1890" height="198" as="geometry" />
        </mxCell>
        <mxCell id="pmB1" value="1-2  Folders, session log&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;raw/, summary/, log/ created. Session log opened; copied to log/fail/ if the run has errors.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="434" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmB2" value="3  Load quality_log&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Under QUALITY_LOCK. Integrity check (checksum, unreadable file, bad dates). First run: log built from existing raw/ files.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="322" y="434" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmB3" value="3  Unknown raw/ files&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;raw/ files that are not in the log are assessed; failed ones get a log entry (recheck on).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="584" y="434" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmB4" value="3  Flag bulk days&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;source = bulk and not older than 180 days: recheck = true. Quality does not matter, the source is the trigger.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="846" y="434" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmB5" value="3b  Self-healing&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Days with validator issues and an old schema version are revalidated from raw/. No API call.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1108" y="434" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmB6" value="3c  Schema migration?&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;GARMIN_SCHEMA_MIGRATE = 1: summaries rebuilt from raw/. raw/ and its backup stay untouched.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#BA7517;fontColor=#854F0B;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1370" y="434" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmB7" value="3d  Backup refresh&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Backup copies of raw/ and source/ compared by content; outdated ones refreshed. Non-fatal.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1632" y="434" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmEdge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#555555;fontSize=11;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pmB1" target="pmB2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pmEdge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#555555;fontSize=11;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pmB2" target="pmB3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pmEdge11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#555555;fontSize=11;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pmB3" target="pmB4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pmEdge12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#555555;fontSize=11;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pmB4" target="pmB5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pmEdge13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#555555;fontSize=11;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pmB5" target="pmB6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pmEdge14" value="next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#555555;fontSize=11;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pmB6" target="pmB7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pmBandC" value="Online preparation  (steps 4 to 8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fa;strokeColor=#36393d;fontColor=#333333;fontSize=14;fontStyle=1;verticalAlign=bottom;align=left;spacingLeft=20;spacingBottom=8;opacity=40;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="638" width="1890" height="610" as="geometry" />
        </mxCell>
        <mxCell id="pmC1" value="4  Login ok?&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Saved token first (probe call). Rejected or none: SSO, with MFA if asked. 429 / 403 on the probe or an open MFA block: no SSO.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#BA7517;fontColor=#854F0B;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="678" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmC2" value="5  Device history&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;get_devices() stored in quality_log. A failure is only a warning.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="322" y="678" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmC3" value="5b  device_id backfill&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Entries without device_id get it from raw/ training_status. Saves the log and device_table.json.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="584" y="678" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmC4" value="5c  Source backfill?&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;GARMIN_SOURCE_BACKFILL = 1: re-fetch API days in SYNC_DATES that have no source/ file.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#BA7517;fontColor=#854F0B;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="846" y="678" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmC5" value="5d  Steps backfill?&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;GARMIN_STEPS_BACKFILL = 1: add steps to archived high days; source/ gets the same patch.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#BA7517;fontColor=#854F0B;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1108" y="678" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmC6" value="5e  Bulk field backfill?&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;GARMIN_BULK_FIELD_BACKFILL = 1: 7 gap fields of bulk days, merged additively into raw/.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#BA7517;fontColor=#854F0B;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1370" y="678" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmC7" value="6  first_day&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;If not set: devices, account profile, SYNC_AUTO_FALLBACK, oldest local file. Never overwritten.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1632" y="678" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmCx1" value="Login failed, exit 1&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Session log copied to log/fail/. Nothing is fetched.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#8f3a3a;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="826" width="222" height="84" as="geometry" />
        </mxCell>
        <mxCell id="pmEdge15" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;fontColor=#555555;fontSize=11;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pmC1" target="pmC2">
