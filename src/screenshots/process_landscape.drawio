        </mxCell>
        <mxCell id="plStore" value="garmin_data/&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;source/ (live API only), raw/, summary/&lt;br&gt;quality_log.json, backup/ ZIPs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1D9E75;fontColor=#0F6E56;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1">
