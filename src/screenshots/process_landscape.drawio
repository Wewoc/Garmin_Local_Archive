        </mxCell>
        <mxCell id="pmD9" value="Worse than stored?&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Rank high 2 &gt; standard 1 &gt; failed 0. No stored entry: never worse.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#BA7517;fontColor=#854F0B;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
