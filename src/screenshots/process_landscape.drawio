        <mxCell id="pmBandD" value="Fetch loop, per day  (step 8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcebf7;strokeColor=#36393d;fontColor=#333333;fontSize=14;fontStyle=1;verticalAlign=bottom;align=left;spacingLeft=20;spacingBottom=8;opacity=40;arcSize=2;" vertex="1" parent="1">
