          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pmC8" value="7  SYNC_DATES set?&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Timer and backfill runs pass a day list. GUI sync and daily_update do not.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#BA7517;fontColor=#854F0B;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="970" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmC9" value="7  Date range&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;recent: last N days to yesterday. range: from to. auto: first_day to yesterday (fallback 90 days).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="322" y="970" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmC10" value="7  Missing days&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Range minus local days (raw/, summary/, legacy files). REFRESH_FAILED: recheck days count as missing. Bulk recheck days always.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="584" y="970" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmC11" value="Anything missing?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#BA7517;fontColor=#854F0B;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="846" y="970" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmC12" value="8  Batch&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;MAX_DAYS_PER_SESSION caps it (0 = all). Capability-enabled endpoints are read once as a snapshot.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1108" y="970" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmCx8" value="Requested days&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;List taken as given: missing = requested days not yet local (all of them if REFRESH_FAILED).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1118" width="222" height="84" as="geometry" />
        </mxCell>
