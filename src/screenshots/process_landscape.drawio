        <mxCell id="pmD1" value="Stop requested?&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Checked before each day (and before every API call).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#BA7517;fontColor=#854F0B;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1334" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmD2" value="Fetch 15 endpoints&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;fetch_raw(): sleep, stress, body battery, heart rate, SpO2, HRV, steps, activities ... plus enabled extras. Random delay per call.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="322" y="1334" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmD3" value="source/ guard&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;write_source() runs before validation: kept if the stored file already has intraday, else written (atomic) and backed up.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0e3;strokeColor=#1D9E75;fontColor=#0F6E56;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="584" y="1334" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmD4" value="Validator critical?&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;validate() against garmin_dataformat.json.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#BA7517;fontColor=#854F0B;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="846" y="1334" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmD5" value="source_api_log&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Per day: validator status, issues, endpoints fetched / failed, size.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1108" y="1334" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmD6" value="Normalize, summarize&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;normalize(api), then summarize(): schema version 3.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1370" y="1334" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmD7" value="Assess quality&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;high: intraday heart-rate or stress values. standard: daily aggregates. failed: nothing usable. Plus per-field labels.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#1a6fbf;fontColor=#185FA5;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1632" y="1334" width="222" height="112" as="geometry" />
        </mxCell>
        <mxCell id="pmDx1" value="Loop ends&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Days already saved stay. Step 9 still runs; the rest waits for the next run.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#888888;fontColor=#444441;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1482" width="222" height="84" as="geometry" />
        </mxCell>
        <mxCell id="pmDx2" value="On HTTP 429&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Critical log, stop event set, loop ends after this day. Other endpoint errors are only listed as failed.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e0;strokeColor=#D85A30;fontColor=#993C1D;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1">
