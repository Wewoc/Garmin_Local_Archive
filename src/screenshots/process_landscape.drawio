        </mxCell>
        <mxCell id="plBulk" value="Bulk import&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Garmin GDPR export (ZIP or folder)&lt;br&gt;timer paused; never writes source/&lt;br&gt;Decision flow, page 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1D9E75;fontColor=#0F6E56;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="plValid" value="Validate, normalize, assess&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot;&gt;validator first, then normalize + summarize&lt;br&gt;label high / standard / failed&lt;br&gt;a worse label never replaces a stored day&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1D9E75;fontColor=#0F6E56;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1">
